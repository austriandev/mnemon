# Postgres started by `pnpm db:up` (docker-compose.yml). Local development only.
MNEMON_DATABASE_URL=postgres://mnemon:mnemon@localhost:54320/mnemon

# Voyage AI embeddings: https://dashboard.voyageai.com
MNEMON_VOYAGE_API_KEY=

# Claude, for record extraction and answers: https://platform.claude.com/settings/keys
MNEMON_ANTHROPIC_API_KEY=

# Web app sign-in. Unset locally: `pnpm web` runs open, and scripts/app.sh makes a code.
# One shared code:
# MNEMON_ACCESS_CODE=choose-a-code
# Or one code per person, name:code[:dollars a day]:
# MNEMON_ACCESS_CODES=alice:alice-code-1234,bob:bob-code-5678:5
# MNEMON_CODE_DAILY_LIMIT_USD=2

# Most the web app spends on paid calls in a day, all codes together. 0 turns them off.
MNEMON_DAILY_LIMIT_USD=5

# Speech to text, to start a meeting from a recording (optional): https://www.assemblyai.com
MNEMON_ASSEMBLYAI_API_KEY=