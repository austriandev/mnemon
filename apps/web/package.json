{
  "name": "@mnemon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "cp -R .next/static .next/standalone/apps/web/.next/ && HOSTNAME=127.0.0.1 PORT=${PORT:-3000} node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mnemon/anthropic": "workspace:*",
    "@mnemon/core": "workspace:*",
    "@mnemon/db": "workspace:*",
    "@mnemon/voyage": "workspace:*",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.1"
  }
}
