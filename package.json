{
  "name": "mnemon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mnemon/db run migrate",
    "ingest": "node --env-file-if-exists=.env apps/cli/src/ingest.ts",
    "retrieve": "node --env-file-if-exists=.env apps/cli/src/retrieve.ts",
    "records": "node --env-file-if-exists=.env apps/cli/src/records.ts",
    "ask": "node --env-file-if-exists=.env apps/cli/src/ask.ts",
    "seed": "node --env-file-if-exists=.env apps/cli/src/seed.ts",
    "eval": "node --env-file-if-exists=.env packages/eval/src/run.ts",
    "web": "pnpm --filter @mnemon/web dev",
    "web:build": "pnpm --filter @mnemon/web build",
    "web:start": "pnpm --filter @mnemon/web start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
